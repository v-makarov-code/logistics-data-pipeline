# Local development only. Copy to .env to override the defaults.
POSTGRES_DB=deals_bigdata
POSTGRES_USER=de_user
POSTGRES_PASSWORD=local_de_password
POSTGRES_PORT=5432
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=local_admin_password
PGADMIN_PORT=5050
# The default window covers the supplied synthetic snapshot; end is exclusive.
ETL_START_DATE=2023-01-01
ETL_END_DATE=2028-01-01
# Shared snapshot date for the route-card Mart and ML dataset preparation.
MART_AS_OF_DATE=2026-10-26
ML_THREAD_COUNT=4
ML_RANDOM_SEED=42
